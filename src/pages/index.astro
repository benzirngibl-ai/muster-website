---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

// Lead-API (eigener kleiner Dienst, gleiches Muster wie asbest-entfernen.de).
// Lokal testbar via PUBLIC_LEAD_API=http://localhost:8080 npm run build.
const LEAD_API = import.meta.env.PUBLIC_LEAD_API ?? 'https://muster-api.k-aizen.de';
// Cal.com self-hosted auf deutschem Server — Terminanfrage-Demo.
// Event „Rückruf-Termin" (15 Min) am 21.07. direkt in der Cal-DB angelegt (Row-Copy von 30min).
const CAL_URL = 'https://cal.k-aizen.de/ben-kaizen/rueckruf';

const TEL_DISPLAY = '0911 00 00 000';
const TEL_HREF = 'tel:+49911000000';

const leistungen = [
  {
    icon: 'wrench',
    titel: 'Dachreparatur & Sturmschäden',
    text: 'Lose Ziegel, undichte Stellen, Sturmschaden — schnelle Hilfe, sauber dokumentiert für Ihre Versicherung.',
  },
  {
    icon: 'roof',
    titel: 'Neueindeckung Steildach',
    text: 'Ziegel, Dachstein oder Schiefer — komplett neu eingedeckt, inklusive Lattung und Unterspannbahn.',
  },
  {
    icon: 'layers',
    titel: 'Flachdach & Abdichtung',
    text: 'Bitumen- und Kunststoffbahnen für Garage, Anbau und Gewerbe — dauerhaft dicht, regelmäßig geprüft.',
  },
  {
    icon: 'window',
    titel: 'Dachfenster',
    text: 'Mehr Licht im Dachgeschoss: Einbau und Austausch, inklusive Innenverkleidung und Anschluss.',
  },
  {
    icon: 'droplet',
    titel: 'Dachrinnen & Spenglerarbeiten',
    text: 'Rinnen, Fallrohre, Kehlen und Anschlüsse aus Zink, Kupfer oder Aluminium — passgenau gefertigt.',
  },
  {
    icon: 'thermometer',
    titel: 'Dämmung & Energie',
    text: 'Aufsparren- und Zwischensparrendämmung nach aktuellem Standard — spürbar weniger Heizkosten.',
  },
];

const ablauf = [
  {
    titel: 'Anfrage senden',
    text: 'Zwei Minuten: kurz beschreiben, was zu tun ist. Ihre Anfrage landet sofort bei uns — nicht in einem Postfach, das abends geleert wird.',
  },
  {
    titel: 'Vor-Ort-Termin',
    text: 'Michael Brandner schaut sich Ihr Dach persönlich an — kostenlos und unverbindlich.',
  },
  {
    titel: 'Festpreis-Angebot in 24 h',
    text: 'Schriftlich, mit festen Positionen. Keine Überraschungen auf der Rechnung. Sie entscheiden in Ruhe.',
  },
];

const stimmen = [
  {
    text: 'Sturmschaden am Freitagabend gemeldet — Samstagfrüh stand jemand auf der Leiter. Das Dach war dicht, bevor der nächste Regen kam.',
    name: 'Familie K., Nürnberg-Erlenstegen',
  },
  {
    text: 'Das Angebot kam wie versprochen am nächsten Tag. Der Preis stand, der Termin stand, und die Baustelle war jeden Abend aufgeräumt.',
    name: 'H. Meier, Fürth',
  },
  {
    text: 'Neueindeckung mit Dämmung in acht Tagen. Die Mannschaft war pünktlich, freundlich — und man merkt, dass der Chef selbst mit anpackt.',
    name: 'S. Wagner, Schwabach',
  },
];
---

<Base title="Dachdeckerei Brandner & Sohn — Meisterbetrieb Nürnberg">
  <!-- ————— Header ————— -->
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand" aria-label="Dachdeckerei Brandner &amp; Sohn — Startseite">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" width="34" height="34" fill="none">
            <path d="M8 15.5V26h16V15.5" stroke="#1C1917" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M3 17.5 16 6l13 11.5" stroke="#C2410C" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
        <span class="brand-text">
          <strong>Brandner &amp; Sohn</strong>
          <small>Dachdeckerei · Meisterbetrieb Nürnberg</small>
        </span>
      </a>
      <nav class="header-actions" aria-label="Kontakt">
        <a href={TEL_HREF} class="header-phone">
          <Icon name="phone" size={19} />
          <span>{TEL_DISPLAY}</span>
        </a>
        <a href="#anfrage" class="btn btn-primary header-cta">Kostenlose Anfrage</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <!-- ————— Hero ————— -->
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="hero-eyebrow">
            <Icon name="map-pin" size={16} /> Nürnberg &amp; Umgebung · seit 1987
          </p>
          <h1>Ihr Dach in Meisterhand.</h1>
          <p class="hero-lead">
            Reparatur, Neueindeckung, Flachdach und Dachfenster — vom Familienbetrieb
            in zweiter Generation. Festes Angebot innerhalb von 24 Stunden.
          </p>
          <div class="hero-ctas">
            <a href="#anfrage" class="btn btn-primary">
              Jetzt Anfrage senden <Icon name="arrow-right" size={18} />
            </a>
            <a href={TEL_HREF} class="btn btn-ghost">
              <Icon name="phone" size={18} /> {TEL_DISPLAY}
            </a>
          </div>
          <ul class="trust-row" aria-label="Auszeichnungen und Kennzahlen">
            <li><Icon name="shield-check" size={18} /> Meisterbetrieb der Dachdecker-Innung</li>
            <li><Icon name="star" size={16} /> 4,9 von 5 · 87 Kundenbewertungen</li>
            <li><Icon name="clock" size={18} /> Rückruf meist innerhalb von 2 Stunden</li>
          </ul>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <svg viewBox="0 0 520 430" class="hero-art" role="img">
            <defs>
              <pattern id="tiles" width="56" height="30" patternUnits="userSpaceOnUse">
                <rect width="56" height="30" fill="#C2410C"></rect>
                <path d="M-14 30a14 14 0 0 1 28 0M14 30a14 14 0 0 1 28 0M42 30a14 14 0 0 1 28 0" fill="none" stroke="rgba(255,255,255,0.28)" stroke-width="2.5"></path>
                <path d="M0 15a14 14 0 0 1 28 0M28 15a14 14 0 0 1 28 0" fill="none" stroke="rgba(122,40,8,0.35)" stroke-width="2.5"></path>
              </pattern>
              <clipPath id="roofClip">
                <path d="M52 196 260 52l208 144z"></path>
              </clipPath>
            </defs>
            <ellipse cx="260" cy="392" rx="215" ry="18" fill="#E7E5E4"></ellipse>
            <!-- Fassade -->
            <rect x="104" y="196" width="312" height="180" fill="#FFFFFF" stroke="#D6D3D1" stroke-width="2"></rect>
            <!-- Tür + Fenster -->
            <rect x="238" y="284" width="52" height="92" rx="3" fill="#1C1917"></rect>
            <circle cx="280" cy="332" r="3" fill="#FAFAF9"></circle>
            <g stroke="#A8A29E" stroke-width="2" fill="#FFF7ED">
              <rect x="136" y="230" width="62" height="62" rx="3"></rect>
              <rect x="322" y="230" width="62" height="62" rx="3"></rect>
              <rect x="136" y="312" width="62" height="62" rx="3"></rect>
              <rect x="322" y="312" width="62" height="62" rx="3"></rect>
            </g>
            <path d="M167 230v62M136 261h62M353 230v62M322 261h62M167 312v62M136 343h62M353 312v62M322 343h62" stroke="#A8A29E" stroke-width="2"></path>
            <!-- Kamin -->
            <rect x="336" y="86" width="42" height="78" fill="#292524"></rect>
            <rect x="330" y="76" width="54" height="14" rx="3" fill="#1C1917"></rect>
            <!-- Dach mit Ziegel-Muster -->
            <path d="M52 196 260 52l208 144z" fill="url(#tiles)" clip-path="url(#roofClip)"></path>
            <path d="M40 200 260 48l220 152" fill="none" stroke="#1C1917" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"></path>
            <!-- Dachfenster -->
            <g transform="rotate(-34.5 175 150)">
              <rect x="150" y="128" width="52" height="44" rx="4" fill="#FFF7ED" stroke="#1C1917" stroke-width="4"></rect>
              <path d="M176 130v40" stroke="#1C1917" stroke-width="3"></path>
            </g>
          </svg>
          <div class="hero-chip chip-top">
            <Icon name="shield-check" size={18} />
            <span><strong>Meisterbetrieb</strong><br />2. Generation</span>
          </div>
          <div class="hero-chip chip-bottom">
            <span class="stars" aria-hidden="true">
              <Icon name="star" size={15} /><Icon name="star" size={15} /><Icon name="star" size={15} /><Icon name="star" size={15} /><Icon name="star" size={15} />
            </span>
            <span><strong>4,9 / 5</strong> · 87 Bewertungen</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ————— Leistungen ————— -->
    <section class="section" id="leistungen">
      <div class="container">
        <div class="section-head">
          <span class="kicker">Leistungen</span>
          <h2>Alles rund ums Dach — aus einer Hand</h2>
          <p>Vom losen Ziegel bis zur kompletten Neueindeckung. Ein Ansprechpartner, ein Festpreis, ein sauberes Ergebnis.</p>
        </div>
        <div class="cards-grid">
          {
            leistungen.map((l) => (
              <article class="card">
                <span class="card-icon">
                  <Icon name={l.icon} size={26} />
                </span>
                <h3>{l.titel}</h3>
                <p>{l.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ————— Warum wir ————— -->
    <section class="section warum">
      <div class="container">
        <div class="section-head">
          <span class="kicker">Warum Brandner &amp; Sohn</span>
          <h2>Vier Dinge, auf die Sie sich verlassen können</h2>
        </div>
        <div class="warum-grid">
          <div class="warum-tile">
            <span class="warum-big">Seit 1987</span>
            <p>Familienbetrieb in zweiter Generation — über 2.400 Dächer in Nürnberg und Umgebung.</p>
          </div>
          <div class="warum-tile">
            <span class="warum-big">Meisterbetrieb</span>
            <p>Eingetragen bei der Dachdecker-Innung. Jede Baustelle wird vom Meister abgenommen.</p>
          </div>
          <div class="warum-tile">
            <span class="warum-big">Festpreis</span>
            <p>Schriftliches Angebot in 24 Stunden. Der Preis, der drinsteht, ist der Preis, den Sie zahlen.</p>
          </div>
          <div class="warum-tile">
            <span class="warum-big">Besenrein</span>
            <p>Gerüst, Schutt, Verpackung — wir hinterlassen die Baustelle jeden Abend aufgeräumt.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ————— Ablauf ————— -->
    <section class="section" id="ablauf">
      <div class="container">
        <div class="section-head">
          <span class="kicker">So läuft&#8217;s ab</span>
          <h2>Von der Anfrage zum fertigen Dach — in drei Schritten</h2>
        </div>
        <ol class="ablauf-grid">
          {
            ablauf.map((s, i) => (
              <li class="ablauf-step">
                <span class="step-nr">{i + 1}</span>
                <h3>{s.titel}</h3>
                <p>{s.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ————— Bewertungen ————— -->
    <section class="section stimmen">
      <div class="container">
        <div class="section-head">
          <span class="kicker">Kundenstimmen</span>
          <h2>Das sagen Hausbesitzer aus der Region</h2>
          <p>4,9 von 5 Sternen aus 87 Bewertungen.</p>
        </div>
        <div class="stimmen-grid">
          {
            stimmen.map((s) => (
              <figure class="stimme">
                <span class="stars" aria-label="5 von 5 Sternen">
                  <Icon name="star" size={16} /><Icon name="star" size={16} /><Icon name="star" size={16} /><Icon name="star" size={16} /><Icon name="star" size={16} />
                </span>
                <blockquote>„{s.text}&#8220;</blockquote>
                <figcaption>{s.name}</figcaption>
              </figure>
            ))
          }
        </div>
        <p class="stimmen-note">Beispielhafte Kundenstimmen des Musterbetriebs.</p>
      </div>
    </section>

    <!-- ————— Über uns ————— -->
    <section class="section ueber">
      <div class="container ueber-inner">
        <div class="ueber-card">
          <span class="kicker">Der Betrieb</span>
          <h2>Handwerk mit Handschlag-Qualität</h2>
          <p>
            Die Dachdeckerei Brandner &amp; Sohn wurde 1987 von Georg Brandner gegründet.
            Heute führt sein Sohn Michael den Betrieb — mit zwölf Mitarbeitern, eigenem
            Lager in der Nürnberger Südstadt und demselben Anspruch wie am ersten Tag:
            Ein Dach ist dann fertig, wenn es dicht ist, gut aussieht und der Kunde ruhig schläft.
          </p>
          <p>
            Sie erreichen uns direkt — kein Callcenter, keine Warteschleife. Wer anruft
            oder schreibt, spricht mit jemandem, der auf dem Dach stand.
          </p>
          <ul class="ueber-facts">
            <li><Icon name="users" size={18} /> 12 Mitarbeiter, davon 3 Meister</li>
            <li><Icon name="map-pin" size={18} /> Einsatzgebiet: Nürnberg, Fürth, Erlangen, Schwabach</li>
            <li><Icon name="clock" size={18} /> Mo–Do 7–16:30 Uhr · Fr 7–14 Uhr · Notdienst bis 22 Uhr</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ————— Anfrage / Kontakt ————— -->
    <section class="section anfrage" id="anfrage">
      <div class="container">
        <div class="section-head">
          <span class="kicker">Kostenlos &amp; unverbindlich</span>
          <h2>Beschreiben Sie kurz, was zu tun ist</h2>
          <p>Ihre Anfrage landet <strong>sofort</strong> bei uns auf dem Handy — Rückruf meist innerhalb von 2 Stunden.</p>
        </div>

        <div class="anfrage-grid">
          <div class="anfrage-info">
            <div class="info-block">
              <h3>Direkter Draht</h3>
              <a href={TEL_HREF} class="info-phone">
                <Icon name="phone" size={20} /> {TEL_DISPLAY}
              </a>
              <p class="info-sub">Mo–Do 7–16:30 Uhr · Fr 7–14 Uhr<br />Notdienst täglich bis 22 Uhr</p>
            </div>
            <div class="info-block">
              <h3>Was passiert mit Ihrer Anfrage?</h3>
              <ul class="info-steps">
                <li>
                  <Icon name="smartphone" size={18} />
                  <span>Sie erscheint <strong>in Sekunden</strong> auf dem Handy des Chefs — nicht morgen früh im Postfach.</span>
                </li>
                <li>
                  <Icon name="phone" size={18} />
                  <span>Wir rufen zurück, meist innerhalb von 2 Stunden (werktags).</span>
                </li>
                <li>
                  <Icon name="calendar" size={18} />
                  <span>Vor-Ort-Termin, dann Festpreis-Angebot in 24 Stunden.</span>
                </li>
              </ul>
            </div>
            <div class="info-block termin-block">
              <h3>Lieber gleich einen Rückruf-Termin?</h3>
              <p class="info-sub">Wählen Sie online ein Zeitfenster — auch abends um zehn, auch vom Sofa aus.</p>
              <a href={CAL_URL} class="btn btn-light" target="_blank" rel="noopener">
                <Icon name="calendar" size={18} /> Rückruf-Termin wählen
              </a>
            </div>
          </div>

          <form class="anfrage-form" method="POST" action={`${LEAD_API}/anfrage`} id="lead-form">
            <div class="form-fehler" id="form-fehler" role="alert" hidden>
              Bitte füllen Sie alle Pflichtfelder aus — dann klappt&#8217;s.
            </div>

            <div class="feld">
              <label for="f-name">Ihr Name <span aria-hidden="true">*</span></label>
              <input type="text" id="f-name" name="name" required autocomplete="name" maxlength="120" />
            </div>

            <div class="feld-reihe">
              <div class="feld">
                <label for="f-telefon">Telefonnummer <span aria-hidden="true">*</span></label>
                <input type="tel" id="f-telefon" name="telefon" required autocomplete="tel" inputmode="tel" maxlength="40" />
                <small>Für den Rückruf — sonst nichts.</small>
              </div>
              <div class="feld">
                <label for="f-ort">PLZ oder Stadtteil <span aria-hidden="true">*</span></label>
                <input type="text" id="f-ort" name="ort" required autocomplete="postal-code" maxlength="80" placeholder="z.&nbsp;B. 90402 oder Erlenstegen" />
              </div>
            </div>

            <div class="feld">
              <label for="f-nachricht">Was ist zu tun? <span aria-hidden="true">*</span></label>
              <textarea id="f-nachricht" name="nachricht" required rows="4" maxlength="1000" placeholder="z. B.: Nach dem Sturm fehlen ein paar Ziegel, es tropft in den Speicher."></textarea>
            </div>

            <div class="feld">
              <label for="f-email">E-Mail <span class="optional">(optional)</span></label>
              <input type="email" id="f-email" name="email" autocomplete="email" inputmode="email" maxlength="200" />
            </div>

            <!-- Honeypot gegen Bots — für Menschen unsichtbar -->
            <div class="hp" aria-hidden="true">
              <label for="f-website">Website</label>
              <input type="text" id="f-website" name="website" tabindex="-1" autocomplete="off" />
            </div>
            <input type="hidden" name="quelle" value="muster-website" />

            <div class="feld feld-check">
              <input type="checkbox" id="f-einwilligung" name="einwilligung" required />
              <label for="f-einwilligung">
                Ich bin einverstanden, dass meine Angaben zur Bearbeitung der Anfrage
                verwendet werden. Details in der <a href="/datenschutz/">Datenschutzerklärung</a>. <span aria-hidden="true">*</span>
              </label>
            </div>

            <button type="submit" class="btn btn-primary form-submit" id="form-submit">
              <Icon name="send" size={18} /> Anfrage absenden
            </button>
            <p class="form-hinweis">Kostenlos &amp; unverbindlich. Ihre Daten bleiben auf deutschen Servern.</p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <!-- ————— Footer ————— -->
  <footer class="site-footer">
    <div class="container footer-grid">
      <div>
        <p class="footer-brand"><strong>Brandner &amp; Sohn</strong><br />Dachdeckerei · Meisterbetrieb</p>
        <address>
          Musterstraße 12<br />
          90402 Nürnberg<br />
          <a href={TEL_HREF}>{TEL_DISPLAY}</a><br />
          info@dachdeckerei-brandner.de
        </address>
      </div>
      <div>
        <p class="footer-title">Leistungen</p>
        <ul>
          <li><a href="#leistungen">Dachreparatur &amp; Notdienst</a></li>
          <li><a href="#leistungen">Neueindeckung</a></li>
          <li><a href="#leistungen">Flachdach &amp; Abdichtung</a></li>
          <li><a href="#leistungen">Dachfenster &amp; Dämmung</a></li>
        </ul>
      </div>
      <div>
        <p class="footer-title">Rechtliches</p>
        <ul>
          <li><a href="/impressum/">Impressum</a></li>
          <li><a href="/datenschutz/">Datenschutz</a></li>
        </ul>
      </div>
    </div>
    <div class="container footer-bottom">
      <p>© 2026 Dachdeckerei Brandner &amp; Sohn — Musterbetrieb</p>
      <p class="footer-demo">
        Muster-Website zur Demonstration, erstellt &amp; betreut von
        <a href="https://k-aizen.de" rel="noopener">k-AIzen, Nürnberg</a> —
        der dargestellte Betrieb ist fiktiv.
      </p>
    </div>
  </footer>

  <script>
    // Fehler-Hinweis nach Server-Redirect (?fehler=felder#anfrage)
    if (new URLSearchParams(location.search).get('fehler')) {
      const box = document.getElementById('form-fehler');
      if (box) box.hidden = false;
    }
    // Senden-Feedback: Button beschäftigt zeigen, Doppel-Submits verhindern.
    const form = document.getElementById('lead-form');
    const btn = document.getElementById('form-submit');
    form?.addEventListener('submit', () => {
      btn?.setAttribute('aria-busy', 'true');
      if (btn) btn.textContent = 'Wird gesendet …';
      setTimeout(() => btn?.setAttribute('disabled', ''), 0);
    });
  </script>
</Base>

<style>
  /* ————— Header ————— */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(250, 250, 249, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--c-border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.7rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--c-ink);
    min-height: 44px;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .brand-text strong {
    font-family: var(--font-head);
    font-size: 1.125rem;
    letter-spacing: -0.01em;
  }
  .brand-text small {
    color: var(--c-soft);
    font-size: 0.78rem;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .header-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--c-ink);
    text-decoration: none;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1rem;
    min-height: 44px;
    padding-inline: 0.25rem;
  }
  .header-phone:hover {
    color: var(--c-primary);
  }
  .header-cta {
    min-height: 44px;
    padding: 0.55rem 1.15rem;
    font-size: 0.95rem;
  }
  @media (max-width: 719px) {
    .brand-text small {
      display: none;
    }
    .header-phone span {
      display: none;
    }
    .header-phone {
      border: 2px solid var(--c-border);
      border-radius: 10px;
      min-width: 44px;
      justify-content: center;
    }
  }

  /* ————— Hero ————— */
  .hero {
    background: linear-gradient(180deg, #fff 0%, var(--c-primary-soft) 100%);
    border-bottom: 1px solid var(--c-primary-soft-2);
  }
  .hero-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-head);
    font-weight: 500;
    font-size: 0.92rem;
    color: var(--c-primary);
    background: #fff;
    border: 1px solid var(--c-primary-soft-2);
